{
  "manifest_version": 3,
  "name": "Forget & Focus",
  "version": "0.1.0",
  "description": "Forget Tabs, Focus on Tasks. — AIがタブを要約・保管し、安心して手放せる忘却支援ツール。",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "activeTab",
    "bookmarks"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
